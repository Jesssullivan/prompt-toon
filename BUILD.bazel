package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob([
        "prompt_toon/**/*.py",
        "tests/**/*.py",
        "docs/**/*.md",
    ]),
)

sh_binary(
    name = "prompt-toon",
    srcs = ["scripts/prompt-toon"],
    data = glob(["prompt_toon/**/*.py"]),
)

filegroup(
    name = "delegation_policy",
    srcs = glob(["policy/**"]),
)

filegroup(
    name = "skills",
    srcs = [
        ".agents/skills/mythos-delegation/SKILL.md",
        ".agents/skills/prompt-toon/SKILL.md",
        ".agents/skills/prompt-toon/agents/openai.yaml",
        ".agents/skills/prompt-toon/references/safety.md",
        ".agents/skills/prompt-toon/references/toon-decision.md",
    ],
)

sh_test(
    name = "unit_tests",
    srcs = ["tests/run_tests.sh"],
    data = [
        ":delegation_policy",
        ":skills",
        # TIN-2706: tests/test_manifest.py regenerates the manifest in-sandbox.
        ":manifest_srcs",
        "//tools/packaging:gen_manifest.py",
    ] + glob([
        "prompt_toon/**/*.py",
        "tests/**/*.py",
        "docs/**/*.md",
    ]),
)

# TIN-2706: everything the packaging-manifest generator reads, so the drift
# gate can regenerate the manifest inside the test sandbox. Skill dirs are
# represented by :skills (iterdir only needs the directories to exist in
# runfiles, which their SKILL.md files guarantee).
filegroup(
    name = "manifest_srcs",
    srcs = [
        "MODULE.bazel",
        "pyproject.toml",
        "packaging/manifest.json",
        "prompt_toon/__init__.py",
        ":delegation_policy",
        ":skills",
    ],
)

test_suite(
    name = "ci_validation_suite",
    tests = [
        ":unit_tests",
        "//tools/packaging:manifest_drift_test",
    ],
)
