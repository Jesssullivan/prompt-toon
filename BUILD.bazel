load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob([
        "prompt_toon/**/*.py",
        "tests/**/*.py",
        "docs/**/*.md",
    ]),
)

sh_binary(
    name = "prompt-toon",
    srcs = ["scripts/prompt-toon"],
    data = glob(["prompt_toon/**/*.py"]),
)

filegroup(
    name = "delegation_policy",
    srcs = glob(["policy/**"]),
)

# List every file under .agents/skills/. The packaging manifest's
# skill_files[] digests all of them. A short list here would starve the
# in-sandbox drift gate of bytes it must hash.
filegroup(
    name = "skills",
    srcs = [
        ".agents/skills/mythos-delegation/SKILL.md",
        ".agents/skills/prompt-toon/SKILL.md",
        ".agents/skills/prompt-toon/agents/openai.yaml",
        ".agents/skills/prompt-toon/references/safety.md",
        ".agents/skills/prompt-toon/references/toon-decision.md",
    ],
)

# A real, deterministic consumer action for the GF enrollment gate. The
# two-pass executor proof builds this from isolated output bases. The warm pass
# executes it remotely. The measured pass must reuse its remote result. The
# test actions still execute in that pass, because test-result caching is off.
genrule(
    name = "gf_cache_probe",
    srcs = ["packaging/manifest.json"],
    outs = ["gf-cache-probe.json"],
    cmd = "cp $(location packaging/manifest.json) $@",
)

sh_test(
    name = "unit_tests",
    size = "large",
    srcs = ["tests/run_tests.sh"],
    data = [
        ".bazelrc.flywheel",
        # J81 golden digests and the .claude project-skill link check read
        # these directly (tests/test_delegation_policy.py).
        ".claude/skills/mythos-delegation/SKILL.md",
        ".claude/skills/prompt-toon/SKILL.md",
        ".github/workflows/bazel-graph.yml",
        ".github/workflows/build-and-test.yml",
        ".github/workflows/ci-flywheel.yml",
        ".github/workflows/native-darwin.yml",
        ".github/workflows/secrets-scan.yml",
        "AGENTS.md",
        "BUILD.bazel",
        "flake.nix",
        "hooks/post_tool_condense.py",
        "Justfile",
        ":delegation_policy",
        ":gf_cache_probe",
        ":skills",
        # J82(d): tests/test_redaction_policy.py diffs the Chapel RE2 specs.
        "//src/ptoon:Redact.chpl",
        # TIN-2706: tests/test_manifest.py regenerates the manifest in-sandbox.
        ":manifest_srcs",
        "tools/anthropic_gateway_canary.py",
        "tools/anthropic_gateway_harness_probe.py",
        "tools/bazel/assert_execution_log.py",
        "//tools/bazel/chapel:defs.bzl",
        "tools/gateway_capacity.py",
        "tools/gen_fixtures.py",
        "tools/openai_gateway_harness_probe.py",
        "tools/quality_runner.py",
        "tools/service_parity.py",
        "tinyland.repo.json",
        "//tools/packaging:gen_manifest.py",
        "//tools/packaging:gen_home_manager_contract.py",
        "//tools/packaging:import_gf_ptoon.py",
        "//tools/bazel/chapel:chpl_from_worker_closure",
        "//tools/bazel/chapel:toolchain.bzl",
    ] + glob([
        "prompt_toon/**/*.py",
        "tests/**/*.py",
        "docs/**/*.md",
    ]),
)

# TIN-2706: everything the packaging-manifest generator reads, so the drift
# gate can regenerate the manifest inside the test sandbox. Skill dirs come in
# through :skills, which must list EVERY file under .agents/skills/. The
# manifest's skill_files[] digests each one. Directory existence is no longer
# enough. tests/test_manifest.py::
# test_bazel_skill_filegroup_declares_every_skill_file asserts this.
filegroup(
    name = "manifest_srcs",
    srcs = [
        "MODULE.bazel",
        "packaging/home-manager.json",
        "packaging/manifest.json",
        "packaging/release-signers.json",
        "packaging/release-signing-key.asc",
        "pyproject.toml",
        "//src/ptoon:native_smoke.sh",
        "//src/ptoon:native_smoke_expected.sh",
        ":delegation_policy",
        ":skills",
    ] + glob(["prompt_toon/**/*.py"]),
)

test_suite(
    name = "ci_validation_suite",
    tests = [
        ":unit_tests",
        "//tools/packaging:manifest_drift_test",
    ],
)
