# TIN-2707: Chapel spike compilation, encoded for the GloriousFlywheel
# remote-execution lane. The target is tagged `manual`, because chpl comes from
# the executor environment (provided by Nix) and not from the local darwin host.
# Once the TIN-2704 enrollment arms, `just flywheel-bazel build
# //spikes/tin-2707:ptoon_spike --config=executor-backed` exercises it. It
# stays out of `//...` until then. The Nix derivation
# `.#packages.x86_64-linux.ptoon-spike-parity` is the equivalent remote path,
# and today it is the primary one.

genrule(
    name = "ptoon_spike",
    srcs = [
        "ptoon_spike.chpl",
        "c_src/normalize_ffi.h",
        "c_src/normalize_ffi.c",
        "c_src/utf8proc.c",
        "c_src/utf8proc_data.c",
        "c_src/utf8proc.h",
    ],
    outs = ["ptoon-spike"],
    cmd = "chpl --fast $(location ptoon_spike.chpl) -o $@",
    tags = [
        "manual",
        "no-sandbox",
    ],
)
