module(
    name = "prompt_toon",
    version = "0.3.0",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.0.0")

# Transitional Linux implementation. Darwin intentionally has no registered
# compiler yet: TIN-2949 must supply a declared, hermetic aarch64-darwin
# toolchain before //src/ptoon:ptoon can analyze for that target platform.
register_toolchains("//tools/bazel/chapel:linux_environmental_toolchain")
