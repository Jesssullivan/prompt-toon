# Vendored utf8proc v2.9.0 and the pt_* NFKC and word-class FFI shim. A
# filegroup lets //src/ptoon:ptoon hand the whole tree to chpl as action
# inputs. The Chapel modules pull these in through a file-relative `require`
# ("../../c_src/normalize_ffi.h" and others). So every file the compile touches
# must be present, including utf8proc_data.c, which utf8proc.c includes.
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "normalize_ffi_srcs",
    srcs = [
        "normalize_ffi.c",
        "normalize_ffi.h",
        "utf8proc.c",
        "utf8proc.h",
        "utf8proc_data.c",
    ],
)

# Vendored public-domain sha256 (B-Con/crypto-algorithms) and the
# pt_sha256_hex FFI shim. src/ptoon/Sha256.chpl pulls them in through a
# file-relative `require` (TIN-2709 C2d). Same shape as normalize_ffi_srcs.
filegroup(
    name = "sha256_srcs",
    srcs = [
        "sha256.c",
        "sha256.h",
        "sha256_ffi.c",
        "sha256_ffi.h",
    ],
)
