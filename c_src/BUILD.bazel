# Vendored utf8proc v2.9.0 + the pt_* NFKC/word-class FFI shim. Exposed as a
# filegroup so //src/ptoon:ptoon can hand the whole tree to chpl as action
# inputs -- the Chapel modules pull these in via file-relative `require`
# ("../../c_src/normalize_ffi.h", ...), so every header the compile touches
# (including utf8proc_data.c #include'd by utf8proc.c) must be present.
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "normalize_ffi_srcs",
    srcs = [
        "normalize_ffi.c",
        "normalize_ffi.h",
        "utf8proc.c",
        "utf8proc.h",
        "utf8proc_data.c",
    ],
)

# Vendored public-domain sha256 (B-Con/crypto-algorithms) + the pt_sha256_hex
# FFI shim, pulled in by src/ptoon/Sha256.chpl via file-relative `require`
# (TIN-2709 C2d). Same shape as normalize_ffi_srcs above.
filegroup(
    name = "sha256_srcs",
    srcs = [
        "sha256.c",
        "sha256.h",
        "sha256_ffi.c",
        "sha256_ffi.h",
    ],
)
