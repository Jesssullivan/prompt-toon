load(":toolchain.bzl", "chapel_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "toolchain.bzl",
])

toolchain_type(
    name = "toolchain_type",
)

# C1/C2 compatibility bridge. The GF Linux worker image owns the pinned chpl
# runtime today; wrapping that lookup in a platform-constrained toolchain makes
# the dependency explicit in analysis and prevents it from resolving for
# Darwin. Its actions are non-cacheable because the ambient compiler is absent
# from the action key. TIN-2949/TIN-2710 replace this implementation with a
# declared rules_nixpkgs compiler closure, not another PATH wrapper.
sh_binary(
    name = "chpl_from_path",
    srcs = ["chpl_from_path.sh"],
)

chapel_toolchain(
    name = "linux_environmental_impl",
    cacheable = False,
    chpl = ":chpl_from_path",
    hermetic = False,
    identity = "gf-linux-executor-environmental-chpl-transition",
    inherit_default_shell_env = True,
    worker_closure_bound = False,
)

toolchain(
    name = "linux_environmental_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    toolchain = ":linux_environmental_impl",
    toolchain_type = ":toolchain_type",
)

# TIN-2949 Darwin production bridge. The worker owns an exact Nix action PATH
# rooted by launchd and verifies the GF Chapel metadata before this wrapper
# invokes chpl. The closure is isolated from the caller host, but remains
# non-cacheable until its digest is represented in the Bazel action key.
sh_binary(
    name = "chpl_from_worker_closure",
    srcs = ["chpl_from_worker_closure.sh"],
)

chapel_toolchain(
    name = "darwin_worker_closure_impl",
    cacheable = False,
    chpl = ":chpl_from_worker_closure",
    hermetic = False,
    identity = "gf-darwin-nix-chapel-ab552d8-worker-closure",
    inherit_default_shell_env = False,
    worker_closure_bound = True,
)

toolchain(
    name = "darwin_worker_closure_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
    toolchain = ":darwin_worker_closure_impl",
    toolchain_type = ":toolchain_type",
)
