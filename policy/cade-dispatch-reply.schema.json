{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Jesssullivan/prompt-toon/main/policy/cade-dispatch-reply.schema.json",
  "title": "cade.dispatch.reply/v1 receiver reply",
  "description": "The one reply object the receiver sends, bare JSON with no label line (TIN-7125 contract-v1 section 5.3). Each kind adds exactly the fields in its row.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "job_id",
    "receipt"
  ],
  "properties": {
    "schema": {
      "const": "cade.dispatch.reply/v1"
    },
    "kind": {
      "enum": [
        "reply",
        "needs-go",
        "dispatch-request",
        "failed",
        "halted"
      ]
    },
    "job_id": {
      "description": "A jobId. A halted ack may carry all. A failed request-invalid reply may carry null when the body named no job.",
      "anyOf": [
        {
          "$ref": "#/$defs/jobId"
        },
        {
          "const": "all"
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt": {
      "description": "null before start, for a halt ack and for reason reply-too-large. receipt.job_id equals job_id.",
      "anyOf": [
        {
          "$ref": "#/$defs/receipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "ask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what",
        "why",
        "by",
        "reply"
      ],
      "properties": {
        "what": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "pattern": "\\S",
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*$"
            }
          ]
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "pattern": "\\S",
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*$"
            }
          ]
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S",
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*$"
            }
          ]
        },
        "reply": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "pattern": "\\S",
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*$"
            }
          ]
        }
      }
    },
    "envelope": {
      "description": "A child cade.dispatch/v1 with no resolution. Cade resolves it against its own ledger row for the parent.",
      "$ref": "#/$defs/envelope"
    },
    "reason": {
      "enum": [
        "request-invalid",
        "envelope-invalid",
        "resolution-missing",
        "resolution-invalid",
        "resolution-disagrees",
        "custody-health",
        "custody-confidential",
        "custody-not-admitted",
        "fable-id-unrecorded",
        "fable-id-mismatch",
        "job-id-reused",
        "login-isolation",
        "launch-failed",
        "job-failed",
        "halt-job-unknown",
        "reply-too-large",
        "halt"
      ]
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S",
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*$"
        }
      ]
    },
    "halted_jobs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/jobId"
      }
    },
    "halt_msg_id": {
      "description": "A ref. For a halt that came by swb, that halt message's swb id, a 26-character ULID. For a stop that did not come by swb, such as the receiver's local stop, the literal local.",
      "$ref": "#/$defs/ref"
    },
    "trimmed": {
      "description": "Present only when the receiver trimmed observed_models to fit the 16384-byte reply (contract section 5.4). The receipt file stays complete.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_models_omitted",
        "receipt_sha256"
      ],
      "properties": {
        "observed_models_omitted": {
          "description": "The number of observed_models entries removed.",
          "type": "integer",
          "minimum": 1
        },
        "receipt_sha256": {
          "description": "The lowercase hex sha256 of the complete receipt file's bytes.",
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "reply"
          }
        }
      },
      "then": {
        "properties": {
          "receipt": {
            "type": "object",
            "properties": {
              "status": {
                "const": "done"
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "ask"
              ]
            },
            {
              "required": [
                "envelope"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "detail"
              ]
            },
            {
              "required": [
                "halted_jobs"
              ]
            },
            {
              "required": [
                "halt_msg_id"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "needs-go"
          }
        }
      },
      "then": {
        "required": [
          "ask"
        ],
        "properties": {
          "receipt": {
            "type": "object",
            "properties": {
              "status": {
                "const": "needs-go"
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "envelope"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "detail"
              ]
            },
            {
              "required": [
                "halted_jobs"
              ]
            },
            {
              "required": [
                "halt_msg_id"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "dispatch-request"
          }
        }
      },
      "then": {
        "required": [
          "envelope"
        ],
        "properties": {
          "receipt": {
            "type": "object",
            "properties": {
              "status": {
                "const": "dispatch-request"
              }
            }
          },
          "envelope": {
            "properties": {
              "depth": {
                "minimum": 1
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "ask"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "detail"
              ]
            },
            {
              "required": [
                "halted_jobs"
              ]
            },
            {
              "required": [
                "halt_msg_id"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "reason",
          "detail"
        ],
        "properties": {
          "receipt": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "failed"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "not": {
              "const": "halt"
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "ask"
              ]
            },
            {
              "required": [
                "envelope"
              ]
            },
            {
              "required": [
                "halted_jobs"
              ]
            },
            {
              "required": [
                "halt_msg_id"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "halted"
          }
        }
      },
      "then": {
        "required": [
          "reason",
          "halted_jobs",
          "halt_msg_id"
        ],
        "properties": {
          "receipt": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "halted"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "const": "halt"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "ask"
              ]
            },
            {
              "required": [
                "envelope"
              ]
            },
            {
              "required": [
                "detail"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "job_id"
        ],
        "properties": {
          "job_id": {
            "const": "all"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "halted"
          },
          "receipt": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "trimmed"
        ]
      },
      "then": {
        "required": [
          "receipt"
        ],
        "properties": {
          "receipt": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "const": "reply-too-large"
          }
        }
      },
      "then": {
        "properties": {
          "receipt": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "job_id"
        ],
        "properties": {
          "job_id": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "kind": {
            "const": "failed"
          },
          "reason": {
            "const": "request-invalid"
          },
          "receipt": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "absPath": {
      "description": "An absolute path with no .. and no control characters.",
      "type": "string",
      "maxLength": 4096,
      "pattern": "^/[^\\u0000-\\u001f\\u007f]*$",
      "not": {
        "pattern": "\\.\\."
      }
    },
    "custody": {
      "description": "Custody classes from widest to narrowest. No dispatch lane admits confidential or health in v1.",
      "enum": [
        "public",
        "ops",
        "confidential",
        "health"
      ]
    },
    "envelope": {
      "description": "A job Cade sends over swb to claude:sting:1:cade-jobs (TIN-7125). Kimi writes lane, tags, goal, inputs, allowed_effects and budget_envelope. Cade's own code stamps the rest, custody from the source item's label included. There is no model field: the resolver picks the root.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "job_id",
        "parent_job_id",
        "depth",
        "root_id",
        "lane",
        "tags",
        "custody",
        "goal",
        "inputs",
        "allowed_effects",
        "requested_by",
        "created_at"
      ],
      "properties": {
        "schema": {
          "const": "cade.dispatch/v1"
        },
        "job_id": {
          "$ref": "#/$defs/jobId"
        },
        "parent_job_id": {
          "description": "The parent job, or null exactly when depth is 0.",
          "anyOf": [
            {
              "$ref": "#/$defs/jobId"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "description": "0 for a root job, parent depth plus one for a child.",
          "type": "integer",
          "minimum": 0
        },
        "root_id": {
          "description": "The root job's id. A root job's root_id is its own job_id.",
          "$ref": "#/$defs/jobId"
        },
        "lane": {
          "$ref": "#/$defs/lane"
        },
        "tags": {
          "description": "Slugged task tags. Cade appends the canonical carve-out tag for every carve-out hit and every inherited carve-out tag.",
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "custody": {
          "description": "From the source item's label, never from the broker.",
          "$ref": "#/$defs/custody"
        },
        "goal": {
          "description": "At most 6000 UTF-8 bytes, checked as bytes. maxLength counts code points, so it bounds the goal and never refuses a valid one; every implementer also counts the UTF-8 bytes and refuses more than 6000 with envelope-invalid. A non-ASCII letter is allowed and makes the carve-out status uncertain.",
          "type": "string",
          "minLength": 1,
          "maxLength": 6000,
          "pattern": "\\S",
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*$"
            }
          ]
        },
        "inputs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "sha256"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/ref"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "allowed_effects": {
          "description": "Effects the job may have without a GO. GO-only effects never appear: the job replies needs-go instead.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/envelopeEffect"
          }
        },
        "budget_envelope": {
          "description": "Optional and report-only. Nothing stops at the limit.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 1
            },
            "wall_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "requested_by": {
          "$ref": "#/$defs/requestedBy"
        },
        "created_at": {
          "$ref": "#/$defs/utc"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "depth"
            ],
            "properties": {
              "depth": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "parent_job_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "parent_job_id"
            ],
            "properties": {
              "parent_job_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "depth": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "allowed_effects"
            ],
            "properties": {
              "allowed_effects": {
                "contains": {
                  "const": "none"
                }
              }
            }
          },
          "then": {
            "properties": {
              "allowed_effects": {
                "maxItems": 1
              }
            }
          }
        }
      ]
    },
    "envelopeEffect": {
      "description": "An effect an envelope may list. none stands alone.",
      "enum": [
        "none",
        "result-doc",
        "linear-comment",
        "linear-issue",
        "github-branch",
        "github-pr"
      ]
    },
    "jobId": {
      "description": "A job id. It names the tmux session job-<id>. all is reserved for halt. A child id is c<depth>- plus the first 20 hex digits of sha256(parent_job_id + LF + n + LF + goal), n counting the parent's dispatch-requests from 1. No newline: some regex engines let $ match before a final newline.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "not": {
        "anyOf": [
          {
            "const": "all"
          },
          {
            "pattern": "\\n"
          }
        ]
      }
    },
    "lane": {
      "description": "A cade.delegate.* lane in policy/delegation.json .cade.dispatch.lanes.",
      "enum": [
        "cade.delegate.research",
        "cade.delegate.draft",
        "cade.delegate.business",
        "cade.delegate.marketing",
        "cade.delegate.develop"
      ]
    },
    "modelId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.:-]{0,63}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "policyRev": {
      "description": "The routing that admitted the job, stamped by Cade's resolution and echoed unchanged: prompt-toon@<tag or commit>+<first 12 hex of sha256(policy/delegation.json)>/cade-dispatch-v1@<first 16 hex of sha256(canonical TABLE)>.",
      "type": "string",
      "pattern": "^prompt-toon@(v[0-9]+\\.[0-9]+\\.[0-9]+|[0-9a-f]{7,40})\\+[0-9a-f]{12}/cade-dispatch-v1@[0-9a-f]{16}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "receipt": {
      "description": "The receipt a started Cade job returns (TIN-7125). It is accounting, not a cap. Every unobserved value is null or left out and names its reason in unobserved.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "job_id",
        "parent_job_id",
        "depth",
        "lane",
        "resolved_root_model",
        "observed_models",
        "children",
        "peak_concurrency",
        "observed_depth",
        "tokens",
        "wall_seconds",
        "effects",
        "go_refs",
        "result",
        "status",
        "policy_rev",
        "seat_rev",
        "unobserved"
      ],
      "properties": {
        "schema": {
          "const": "cade.dispatch.receipt/v1"
        },
        "job_id": {
          "$ref": "#/$defs/jobId"
        },
        "parent_job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/jobId"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "lane": {
          "$ref": "#/$defs/lane"
        },
        "resolved_root_model": {
          "description": "resolution.root_model, the model passed to claude --model. Never null.",
          "$ref": "#/$defs/modelId"
        },
        "observed_models": {
          "description": "Only models read from the session's own events: the stream-json init event for root and each child's transcript. A model from an agent file is declared, not observed, and is not listed.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit",
              "model"
            ],
            "properties": {
              "unit": {
                "$ref": "#/$defs/unit"
              },
              "model": {
                "$ref": "#/$defs/modelId"
              }
            }
          }
        },
        "children": {
          "description": "Subagents started plus child jobs requested. Never null. With hook-rows-missing it is a lower bound.",
          "type": "integer",
          "minimum": 0
        },
        "peak_concurrency": {
          "type": "integer",
          "minimum": 0
        },
        "observed_depth": {
          "description": "The deepest subagent depth a hook reported. 0 when no subagent started. null when subagents started and no hook reported a depth.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens": {
          "anyOf": [
            {
              "description": "Stream usage: input_tokens, output_tokens, cache_read_input_tokens and cache_creation_input_tokens map to input, output, cache_read and cache_write. total is the sum of the four.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input",
                "output",
                "cache_read",
                "cache_write",
                "total"
              ],
              "properties": {
                "input": {
                  "type": "integer",
                  "minimum": 0
                },
                "output": {
                  "type": "integer",
                  "minimum": 0
                },
                "cache_read": {
                  "type": "integer",
                  "minimum": 0
                },
                "cache_write": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "wall_seconds": {
          "description": "Measured by the launcher.",
          "type": "number",
          "minimum": 0
        },
        "effects": {
          "description": "Effects the job had. An empty list means no effect.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effect",
              "ref"
            ],
            "properties": {
              "effect": {
                "$ref": "#/$defs/receiptEffect"
              },
              "ref": {
                "$ref": "#/$defs/ref"
              }
            }
          }
        },
        "go_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "result": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/absPath"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "done",
            "failed",
            "needs-go",
            "dispatch-request",
            "halted"
          ]
        },
        "policy_rev": {
          "description": "Copied from resolution.policy_rev unchanged.",
          "$ref": "#/$defs/policyRev"
        },
        "seat_rev": {
          "$ref": "#/$defs/seatRev"
        },
        "unobserved": {
          "description": "Why a value is null or incomplete. Keys are observed_models, observed_depth, tokens and children.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "observed_models": {
              "$ref": "#/$defs/unobservedReason"
            },
            "observed_depth": {
              "$ref": "#/$defs/unobservedReason"
            },
            "tokens": {
              "$ref": "#/$defs/unobservedReason"
            },
            "children": {
              "$ref": "#/$defs/unobservedReason"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "done"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "depth"
            ],
            "properties": {
              "depth": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "parent_job_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "parent_job_id"
            ],
            "properties": {
              "parent_job_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "depth": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "observed_depth"
            ],
            "properties": {
              "observed_depth": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "unobserved": {
                "required": [
                  "observed_depth"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tokens"
            ],
            "properties": {
              "tokens": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "unobserved": {
                "required": [
                  "tokens"
                ]
              }
            }
          }
        }
      ]
    },
    "receiptEffect": {
      "description": "An effect a receipt records. none is never recorded: an empty list means no effect.",
      "enum": [
        "result-doc",
        "linear-comment",
        "linear-issue",
        "github-branch",
        "github-pr",
        "spend",
        "external-send",
        "host-act",
        "merge",
        "credential-change"
      ]
    },
    "ref": {
      "description": "A reference with no spaces or control characters.",
      "type": "string",
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]{1,500}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "requestedBy": {
      "description": "For example jess@discord or job:<parent_job_id>.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9:._@-]{0,127}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "seatRev": {
      "description": "The job seat that ran the job: the sha256 of lab vars/cade_dispatch.json and lab's own prompt-toon pin.",
      "type": "string",
      "pattern": "^cade-dispatch-seat@[0-9a-f]{16}/prompt-toon@(v[0-9]+\\.[0-9]+\\.[0-9]+|[0-9a-f]{7,40})\\+[0-9a-f]{12}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "tag": {
      "description": "A slugged task tag, ASCII only. Cade slugs each raw tag after NFKC and refuses one with a non-ASCII letter or an empty slug, so a non-ASCII tag on the wire fails this pattern.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "unit": {
      "description": "A unit name. The root unit is root.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "unobservedReason": {
      "enum": [
        "stream-missing",
        "stream-no-usage",
        "root-model-unobserved",
        "unit-model-unobserved",
        "hook-no-depth",
        "hook-rows-missing"
      ]
    },
    "utc": {
      "description": "RFC 3339 in UTC only. Writers emit Z. Readers accept 0 to 6 fraction digits.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "not": {
        "pattern": "\\n"
      }
    }
  }
}
