{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Jesssullivan/prompt-toon/main/policy/cade-dispatch-request.schema.json",
  "title": "cade.dispatch.request/v1 dispatch request",
  "description": "What Cade sends after the swb label line (TIN-7125 contract-v1 section 4.2). The receiver strips exactly that line and refuses a request without resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "envelope",
    "resolution"
  ],
  "properties": {
    "schema": {
      "const": "cade.dispatch.request/v1"
    },
    "kind": {
      "const": "dispatch"
    },
    "envelope": {
      "$ref": "#/$defs/envelope"
    },
    "resolution": {
      "$ref": "#/$defs/resolution"
    }
  },
  "$defs": {
    "carveOutTag": {
      "enum": [
        "adversarial",
        "red-team",
        "purple-team",
        "deep-iteration"
      ]
    },
    "custody": {
      "description": "Custody classes from widest to narrowest. No dispatch lane admits confidential or health in v1.",
      "enum": [
        "public",
        "ops",
        "confidential",
        "health"
      ]
    },
    "envelope": {
      "description": "A job Cade sends over swb to claude:sting:1:cade-jobs (TIN-7125). Kimi writes lane, tags, goal, inputs, allowed_effects and budget_envelope. Cade's own code stamps the rest, custody from the source item's label included. There is no model field: the resolver picks the root.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "job_id",
        "parent_job_id",
        "depth",
        "root_id",
        "lane",
        "tags",
        "custody",
        "goal",
        "inputs",
        "allowed_effects",
        "requested_by",
        "created_at"
      ],
      "properties": {
        "schema": {
          "const": "cade.dispatch/v1"
        },
        "job_id": {
          "$ref": "#/$defs/jobId"
        },
        "parent_job_id": {
          "description": "The parent job, or null exactly when depth is 0.",
          "anyOf": [
            {
              "$ref": "#/$defs/jobId"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "description": "0 for a root job, parent depth plus one for a child.",
          "type": "integer",
          "minimum": 0
        },
        "root_id": {
          "description": "The root job's id. A root job's root_id is its own job_id.",
          "$ref": "#/$defs/jobId"
        },
        "lane": {
          "$ref": "#/$defs/lane"
        },
        "tags": {
          "description": "Slugged task tags. Cade appends the canonical carve-out tag for every carve-out hit and every inherited carve-out tag.",
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "custody": {
          "description": "From the source item's label, never from the broker.",
          "$ref": "#/$defs/custody"
        },
        "goal": {
          "description": "At most 6000 UTF-8 bytes, checked as bytes. maxLength counts code points, so it bounds the goal and never refuses a valid one; every implementer also counts the UTF-8 bytes and refuses more than 6000 with envelope-invalid. A non-ASCII letter is allowed and makes the carve-out status uncertain.",
          "type": "string",
          "minLength": 1,
          "maxLength": 6000,
          "pattern": "\\S",
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*$"
            }
          ]
        },
        "inputs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "sha256"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/ref"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "allowed_effects": {
          "description": "Effects the job may have without a GO. GO-only effects never appear: the job replies needs-go instead.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/envelopeEffect"
          }
        },
        "budget_envelope": {
          "description": "Optional and report-only. Nothing stops at the limit.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 1
            },
            "wall_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "requested_by": {
          "$ref": "#/$defs/requestedBy"
        },
        "created_at": {
          "$ref": "#/$defs/utc"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "depth"
            ],
            "properties": {
              "depth": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "parent_job_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "parent_job_id"
            ],
            "properties": {
              "parent_job_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "depth": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "allowed_effects"
            ],
            "properties": {
              "allowed_effects": {
                "contains": {
                  "const": "none"
                }
              }
            }
          },
          "then": {
            "properties": {
              "allowed_effects": {
                "maxItems": 1
              }
            }
          }
        }
      ]
    },
    "envelopeEffect": {
      "description": "An effect an envelope may list. none stands alone.",
      "enum": [
        "none",
        "result-doc",
        "linear-comment",
        "linear-issue",
        "github-branch",
        "github-pr"
      ]
    },
    "jobId": {
      "description": "A job id. It names the tmux session job-<id>. all is reserved for halt. A child id is c<depth>- plus the first 20 hex digits of sha256(parent_job_id + LF + n + LF + goal), n counting the parent's dispatch-requests from 1. No newline: some regex engines let $ match before a final newline.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "not": {
        "anyOf": [
          {
            "const": "all"
          },
          {
            "pattern": "\\n"
          }
        ]
      }
    },
    "lane": {
      "description": "A cade.delegate.* lane in policy/delegation.json .cade.dispatch.lanes.",
      "enum": [
        "cade.delegate.research",
        "cade.delegate.draft",
        "cade.delegate.business",
        "cade.delegate.marketing",
        "cade.delegate.develop"
      ]
    },
    "modelId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.:-]{0,63}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "policyRev": {
      "description": "The routing that admitted the job, stamped by Cade's resolution and echoed unchanged: prompt-toon@<tag or commit>+<first 12 hex of sha256(policy/delegation.json)>/cade-dispatch-v1@<first 16 hex of sha256(canonical TABLE)>.",
      "type": "string",
      "pattern": "^prompt-toon@(v[0-9]+\\.[0-9]+\\.[0-9]+|[0-9a-f]{7,40})\\+[0-9a-f]{12}/cade-dispatch-v1@[0-9a-f]{16}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "ref": {
      "description": "A reference with no spaces or control characters.",
      "type": "string",
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]{1,500}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "requestedBy": {
      "description": "For example jess@discord or job:<parent_job_id>.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9:._@-]{0,127}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "resolution": {
      "description": "Cade's resolution of an envelope (TIN-7125 contract-v1 section 4.4). The receiver re-runs the resolver and refuses on any disagreement.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "root_class",
        "root_model",
        "reroute",
        "carve_out_hits",
        "custody",
        "source_label",
        "child_policy",
        "policy_rev",
        "dedupe_key",
        "resolved_at"
      ],
      "properties": {
        "schema": {
          "const": "cade.dispatch.resolution/v1"
        },
        "root_class": {
          "enum": [
            "fable",
            "opus"
          ]
        },
        "root_model": {
          "description": "claude-opus-5-5 for Opus. For Fable, the id read from the account. A Fable id never lands in source, policy or fixtures.",
          "$ref": "#/$defs/modelId"
        },
        "reroute": {
          "description": "Set only when a Fable lane moved to Opus. Contract section 6.1 gives the precedence: own tag hit, inherited hit, goal hit, then a goal with a non-ASCII letter after NFKC.",
          "enum": [
            null,
            "carve-out",
            "carve-out-inherited",
            "carve-out-inferred",
            "carve-out-uncertain"
          ]
        },
        "carve_out_hits": {
          "description": "Sorted and unique.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/carveOutTag"
          }
        },
        "custody": {
          "description": "Equals envelope.custody.",
          "$ref": "#/$defs/custody"
        },
        "source_label": {
          "description": "The source item's label, verbatim, for the card. At most 64 UTF-8 bytes, checked as bytes: maxLength counts code points and is only a bound. The receiver uses it for no custody check.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "child_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "orchestrator",
            "fable_runs_units",
            "fable_forbidden",
            "units",
            "carve_out_tags",
            "custody_rule",
            "effects_rule",
            "child_jobs",
            "on_no_seat",
            "provider_fallback",
            "accounting"
          ],
          "properties": {
            "orchestrator": {
              "enum": [
                "fable",
                "opus"
              ]
            },
            "fable_runs_units": {
              "const": false
            },
            "fable_forbidden": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "adversarial-analysis",
                  "purple-team",
                  "red-team",
                  "deep-iteration-hammering",
                  "bulk-execution"
                ]
              }
            },
            "units": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "research",
                "bulk",
                "code",
                "gate",
                "carve-out",
                "unknown"
              ],
              "properties": {
                "research": {
                  "const": [
                    "claude-sonnet-5-5",
                    "claude-haiku-5-5"
                  ]
                },
                "bulk": {
                  "const": [
                    "claude-haiku-5-5",
                    "claude-sonnet-5-5"
                  ]
                },
                "code": {
                  "const": [
                    "claude-opus-5-5"
                  ]
                },
                "gate": {
                  "const": [
                    "claude-opus-5-5"
                  ]
                },
                "carve-out": {
                  "const": [
                    "claude-opus-5-5"
                  ]
                },
                "unknown": {
                  "const": [
                    "claude-opus-5-5"
                  ]
                }
              }
            },
            "carve_out_tags": {
              "description": "The same list as carve_out_hits.",
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/carveOutTag"
              }
            },
            "custody_rule": {
              "const": "narrow-only"
            },
            "effects_rule": {
              "const": "narrow-only"
            },
            "child_jobs": {
              "const": "dispatch-request"
            },
            "on_no_seat": {
              "const": "wait"
            },
            "provider_fallback": {
              "const": "none"
            },
            "accounting": {
              "const": "report-only"
            }
          }
        },
        "policy_rev": {
          "$ref": "#/$defs/policyRev"
        },
        "dedupe_key": {
          "description": "The lowercase hex sha256 of the UTF-8 bytes of root_id + LF + goal, the envelope's values exactly as sent with no normalization. The receiver recomputes it and refuses a mismatch with resolution-invalid.",
          "$ref": "#/$defs/sha256"
        },
        "resolved_at": {
          "$ref": "#/$defs/utc"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "reroute"
            ],
            "properties": {
              "reroute": {
                "enum": [
                  "carve-out",
                  "carve-out-inherited",
                  "carve-out-inferred",
                  "carve-out-uncertain"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "root_class": {
                "const": "opus"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "root_class"
            ],
            "properties": {
              "root_class": {
                "const": "fable"
              }
            }
          },
          "then": {
            "properties": {
              "child_policy": {
                "properties": {
                  "orchestrator": {
                    "const": "fable"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "root_class"
            ],
            "properties": {
              "root_class": {
                "const": "opus"
              }
            }
          },
          "then": {
            "properties": {
              "child_policy": {
                "properties": {
                  "orchestrator": {
                    "const": "opus"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "tag": {
      "description": "A slugged task tag, ASCII only. Cade slugs each raw tag after NFKC and refuses one with a non-ASCII letter or an empty slug, so a non-ASCII tag on the wire fails this pattern.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "not": {
        "pattern": "\\n"
      }
    },
    "utc": {
      "description": "RFC 3339 in UTC only. Writers emit Z. Readers accept 0 to 6 fraction digits.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "not": {
        "pattern": "\\n"
      }
    }
  }
}
