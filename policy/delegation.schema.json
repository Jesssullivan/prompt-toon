{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Jesssullivan/prompt-toon/main/policy/delegation.schema.json",
  "title": "Toon of Mythos delegation policy",
  "description": "Shape of policy/delegation.json, the validated transition artifact generated from policy/dhall/delegation.dhall. Owner: TIN-2698. This describes the Jesssullivan/prompt-toon delegation policy only; tinyland-inc/lab ships a same-named policy/delegation.json with an unrelated interview-HITL schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$comment",
    "schema_version",
    "metadata",
    "scarce_resources",
    "providers",
    "seats",
    "harness_seats",
    "personas",
    "lanes",
    "budget_fallbacks",
    "cade",
    "enforcement",
    "attribution"
  ],
  "properties": {
    "$comment": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "Provenance banner naming the Dhall source of truth and its regeneration command."
    },
    "schema_version": {
      "type": "integer",
      "const": 4
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner_linear_issue", "founding_docs"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "owner_linear_issue": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]+$"
        },
        "founding_docs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "scarce_resources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "notes"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": { "enum": ["human", "model"] },
          "notes": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "providers": {
      "description": "Provider allow-list (TIN-7760). Each entry names the exact model ids a seat on that provider may run, its access path and its endpoints. Model ids are keyed by endpoint. A seat whose provider, endpoint or model id is not admitted fails closed.",
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "model_ids", "access", "endpoints", "notes"],
        "properties": {
          "id": { "$ref": "#/$defs/providerId" },
          "model_ids": {
            "description": "The model ids on this provider's admitted endpoints. A forbidden endpoint's ids never appear here.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/modelId" }
          },
          "access": { "$ref": "#/$defs/nonEmptyString" },
          "endpoints": {
            "description": "Access paths to the provider, each with the model ids it uses. A refused endpoint is listed with admitted false so a consumer can recognise and refuse it.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "model_ids", "admitted", "status", "notes"],
              "properties": {
                "id": { "$ref": "#/$defs/endpointId" },
                "model_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/modelId" }
                },
                "admitted": { "type": "boolean" },
                "status": { "enum": ["in-service", "unmeasured", "forbidden"] },
                "notes": { "$ref": "#/$defs/nonEmptyString" }
              },
              "allOf": [
                {
                  "if": { "required": ["id"], "properties": { "id": { "const": "moonshot-platform" } } },
                  "then": { "properties": { "admitted": { "const": false }, "status": { "const": "forbidden" } } }
                },
                {
                  "if": { "required": ["id"], "properties": { "id": { "const": "kimi-coding" } } },
                  "then": { "properties": { "model_ids": { "items": { "enum": ["k3.1-pro"] } } } }
                },
                {
                  "if": { "required": ["status"], "properties": { "status": { "const": "forbidden" } } },
                  "then": { "properties": { "admitted": { "const": false } } }
                },
                {
                  "if": { "required": ["admitted"], "properties": { "admitted": { "const": false } } },
                  "then": { "properties": { "status": { "const": "forbidden" } } }
                }
              ]
            }
          },
          "notes": { "$ref": "#/$defs/nonEmptyString" }
        },
        "allOf": [
          {
            "if": { "required": ["id"], "properties": { "id": { "const": "anthropic" } } },
            "then": {
              "properties": {
                "model_ids": { "items": { "pattern": "^claude-(opus|sonnet|haiku)-5-5$" } },
                "endpoints": { "items": { "properties": { "id": { "const": "anthropic" } } } }
              }
            }
          },
          {
            "if": { "required": ["id"], "properties": { "id": { "const": "kimi" } } },
            "then": {
              "properties": {
                "model_ids": { "items": { "enum": ["k3.1-pro"] } },
                "endpoints": {
                  "items": { "properties": { "id": { "enum": ["kimi-coding", "moonshot-platform"] } } },
                  "allOf": [
                    { "contains": { "properties": { "id": { "const": "kimi-coding" }, "admitted": { "const": true } } } },
                    { "contains": { "properties": { "id": { "const": "moonshot-platform" }, "admitted": { "const": false } } } }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "seats": {
      "description": "First-class seat records. Seat names are load-bearing routing identities, not free-form model_classes strings.",
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "model_class",
          "provider",
          "cost_tier",
          "default_personas",
          "forbidden_personas",
          "notes"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/seatId" },
          "model_class": { "$ref": "#/$defs/seatId" },
          "model_id": {
            "description": "Exact model the seat runs (J81). Omitted for a provider-managed seat such as fable.",
            "$ref": "#/$defs/modelId"
          },
          "provider": {
            "description": "The providers[] entry whose allow-list admits this seat's model_id.",
            "$ref": "#/$defs/providerId"
          },
          "endpoint": {
            "description": "The admitted provider endpoint whose model_ids hold this seat's model_id. Omitted for Anthropic seats, whose ids do not vary by endpoint.",
            "$ref": "#/$defs/endpointId"
          },
          "cost_tier": { "enum": ["scarce", "high", "medium", "low"] },
          "default_personas": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "forbidden_personas": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "notes": { "$ref": "#/$defs/nonEmptyString" }
        },
        "allOf": [
          {
            "if": { "required": ["model_class"], "properties": { "model_class": { "const": "fable" } } },
            "then": { "allOf": [ { "not": { "required": ["model_id"] } }, { "not": { "required": ["endpoint"] } } ], "properties": { "provider": { "const": "anthropic" } } }
          },
          {
            "if": { "required": ["model_class"], "properties": { "model_class": { "const": "kimi" } } },
            "then": {
              "required": ["model_id", "endpoint"],
              "properties": {
                "model_id": { "const": "k3.1-pro" },
                "provider": { "const": "kimi" },
                "endpoint": { "const": "kimi-coding" },
                "default_personas": {
                  "not": { "contains": { "enum": ["fable", "critical", "adversarial"] } }
                },
                "forbidden_personas": {
                  "allOf": [
                    { "contains": { "const": "fable" } },
                    { "contains": { "const": "critical" } },
                    { "contains": { "const": "adversarial" } }
                  ]
                }
              }
            }
          },
          {
            "if": { "required": ["model_class"], "properties": { "model_class": { "const": "opus" } } },
            "then": { "required": ["model_id"], "not": { "required": ["endpoint"] }, "properties": { "model_id": { "pattern": "^claude-opus-" }, "provider": { "const": "anthropic" } } }
          },
          {
            "if": { "required": ["model_class"], "properties": { "model_class": { "const": "sonnet" } } },
            "then": { "required": ["model_id"], "not": { "required": ["endpoint"] }, "properties": { "model_id": { "pattern": "^claude-sonnet-" }, "provider": { "const": "anthropic" } } }
          },
          {
            "if": { "required": ["model_class"], "properties": { "model_class": { "const": "haiku" } } },
            "then": { "required": ["model_id"], "not": { "required": ["endpoint"] }, "properties": { "model_id": { "pattern": "^claude-haiku-" }, "provider": { "const": "anthropic" } } }
          }
        ]
      }
    },
    "harness_seats": {
      "description": "Agent-harness dispatch identities Fable may delegate bounded technical work to. A harness seat is not a model class and never appears in a persona's model_classes: it names the harness, the model lane it rides, the exact task envelope it may receive, the launcher surface dispatch must go through, and its evidentiary-only posture.",
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "harness",
          "model_lane",
          "purpose",
          "delegable_tasks",
          "forbidden_tasks",
          "dispatch_surface",
          "posture"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/harnessSeatId" },
          "harness": { "$ref": "#/$defs/harnessId" },
          "model_lane": { "$ref": "#/$defs/nonEmptyString" },
          "purpose": { "$ref": "#/$defs/nonEmptyString" },
          "delegable_tasks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "forbidden_tasks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "dispatch_surface": { "$ref": "#/$defs/nonEmptyString" },
          "posture": {
            "description": "Harness output is evidence for the synthesis seat. There is no other posture: a harness seat never carries the operator WORD leg.",
            "enum": ["evidentiary-only"]
          }
        }
      }
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "model_classes",
          "purpose",
          "doctrine",
          "forbidden_tasks"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "model_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/modelClass" }
          },
          "purpose": { "$ref": "#/$defs/nonEmptyString" },
          "doctrine": { "$ref": "#/$defs/nonEmptyString" },
          "forbidden_tasks": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route", "persona", "purpose"],
        "properties": {
          "route": { "$ref": "#/$defs/route" },
          "persona": {
            "description": "A persona id, or a harness seat id for a mythos.delegate.* lane.",
            "$ref": "#/$defs/identifier"
          },
          "purpose": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "budget_fallbacks": {
      "description": "Seat downgrades allowed when a seat's quota is exhausted (J81(e)). Each names the personas and the exact lanes it reaches plus the obligations the downgraded lane carries. A fallback never reaches fable or haiku, the adversarial persona, the merge gate or a host act. It always carries the merge, host-act and receipt obligations.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from_seat",
          "to_seat",
          "trigger",
          "personas",
          "lanes",
          "obligations"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "from_seat": { "$ref": "#/$defs/seatId" },
          "to_seat": {
            "$ref": "#/$defs/seatId",
            "not": { "enum": ["fable", "haiku", "kimi"] }
          },
          "trigger": { "$ref": "#/$defs/nonEmptyString" },
          "personas": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" },
            "not": { "contains": { "const": "adversarial" } }
          },
          "lanes": {
            "description": "Every route the fallback reaches. A lane of a covered persona that is not listed keeps its default seat.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/route" },
            "not": {
              "contains": {
                "enum": ["mythos.gate.review", "mythos.act.host", "mythos.adversarial"]
              }
            }
          },
          "obligations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" },
            "allOf": [
              { "contains": { "const": "merge-waits-for-opus-review" } },
              { "contains": { "const": "no-host-or-credential-act" } },
              { "contains": { "const": "downgrade-recorded-in-receipt" } }
            ]
          }
        }
      }
    },
    "cade": {
      "description": "Cade orchestration (TIN-7760): the orchestrator, the advisory cross-provider review, the auto-level child rule, custody classes and the cade.* lanes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "cross_provider_review", "children", "custody_classes", "lanes"],
      "properties": {
        "orchestrator": { "$ref": "#/$defs/nonEmptyString" },
        "cross_provider_review": { "$ref": "#/$defs/nonEmptyString" },
        "children": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "custody", "seat_resolution", "on_no_seat", "provider_fallback", "bindings", "notes"],
          "properties": {
            "level": { "const": "auto" },
            "custody": { "const": "follows-parent-home" },
            "seat_resolution": {
              "description": "A child's effective seats are its lane's default and alternate seats, in that order, that also sit in its parent home's custody class.",
              "const": "lane-seats-within-parent-custody"
            },
            "on_no_seat": {
              "description": "When no effective seat remains the child waits. It never borrows a seat from outside its parent home's custody.",
              "const": "wait"
            },
            "provider_fallback": { "const": "none" },
            "bindings": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" },
              "allOf": [
                { "contains": { "const": "batch-confirm-for-external-acts" } },
                { "contains": { "const": "health-never-hosted" } },
                { "contains": { "const": "client-exports-never-kimi" } },
                { "contains": { "const": "ownership-and-live-session-checks" } },
                { "contains": { "const": "hooks-advisory" } }
              ]
            },
            "notes": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "custody_classes": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "seats", "notes"],
            "properties": {
              "id": { "$ref": "#/$defs/custodyId" },
              "seats": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["opus", "kimi"] }
              },
              "notes": { "$ref": "#/$defs/nonEmptyString" }
            },
            "allOf": [
              {
                "if": { "required": ["id"], "properties": { "id": { "const": "confidential" } } },
                "then": { "properties": { "seats": { "items": { "const": "opus" } } } }
              },
              {
                "if": { "required": ["id"], "properties": { "id": { "const": "health" } } },
                "then": { "properties": { "seats": { "type": "array", "not": { "contains": {} } } } }
              }
            ]
          }
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["route", "persona", "custody", "default_seat", "alternate_seats", "gate", "purpose"],
            "properties": {
              "route": { "$ref": "#/$defs/cadeRoute" },
              "persona": { "$ref": "#/$defs/identifier" },
              "custody": {
                "$ref": "#/$defs/custodyId",
                "not": { "const": "health" }
              },
              "default_seat": { "enum": ["opus", "kimi"] },
              "alternate_seats": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["opus", "kimi"] }
              },
              "gate": { "$ref": "#/$defs/nonEmptyString" },
              "purpose": { "$ref": "#/$defs/nonEmptyString" }
            },
            "allOf": [
              {
                "if": { "required": ["custody"], "properties": { "custody": { "const": "confidential" } } },
                "then": {
                  "properties": {
                    "default_seat": { "const": "opus" },
                    "alternate_seats": { "not": { "contains": { "const": "kimi" } } }
                  }
                }
              },
              {
                "if": { "required": ["persona"], "properties": { "persona": { "enum": ["critical", "adversarial"] } } },
                "then": {
                  "properties": {
                    "default_seat": { "const": "opus" },
                    "alternate_seats": { "not": { "contains": { "const": "kimi" } } }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "enforcement": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "rule"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "severity": { "enum": ["error", "warn"] },
          "rule": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["convention", "values"],
      "properties": {
        "convention": { "$ref": "#/$defs/nonEmptyString" },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "route": {
      "type": "string",
      "pattern": "^mythos(\\.[a-z0-9-]+)+$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "cadeRoute": {
      "type": "string",
      "pattern": "^cade(\\.[a-z0-9-]+)+$"
    },
    "seatId": {
      "description": "First-class seat names. Adding a seat is a policy change, not a string edit.",
      "enum": ["fable", "opus", "sonnet", "haiku", "kimi"]
    },
    "providerId": {
      "description": "Allow-listed providers. Adding one is a policy change, not a string edit.",
      "enum": ["anthropic", "kimi"]
    },
    "custodyId": {
      "description": "Cade custody classes. A child's custody class follows its parent home.",
      "enum": ["confidential", "health", "ops", "public"]
    },
    "modelId": {
      "description": "An exact model ID: a Claude ID such as claude-opus-5-5, the Kimi Code id k3.1-pro, or the forbidden Platform id kimi-k3.1-pro, which only a refused endpoint may list.",
      "type": "string",
      "pattern": "^(claude-(opus|sonnet|haiku)-[0-9]+-[0-9]+|k3\\.1-pro|kimi-k3\\.1-pro)$"
    },
    "endpointId": {
      "description": "Provider endpoints. Adding one is a policy change, not a string edit.",
      "enum": ["anthropic", "kimi-coding", "moonshot-platform"]
    },
    "harnessSeatId": {
      "description": "First-class harness-seat names. Adding one is a policy change, not a string edit.",
      "enum": ["pi", "pi-k3"]
    },
    "harnessId": {
      "description": "The agent harness a seat dispatches through. Kimi has no dispatch envelope of its own, so the Kimi reviewer rides the pi harness as pi-k3.",
      "enum": ["pi"]
    },
    "modelClass": {
      "description": "A seat name, or the operator taking the lane personally.",
      "enum": ["fable", "opus", "sonnet", "haiku", "kimi", "operator"]
    }
  }
}
