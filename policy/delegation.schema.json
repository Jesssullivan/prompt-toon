{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Jesssullivan/prompt-toon/main/policy/delegation.schema.json",
  "title": "Toon of Mythos delegation policy",
  "description": "Shape of policy/delegation.json, the validated transition artifact generated from policy/dhall/delegation.dhall. Owner: TIN-2698. This describes the Jesssullivan/prompt-toon delegation policy only; tinyland-inc/lab ships a same-named policy/delegation.json with an unrelated interview-HITL schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$comment",
    "schema_version",
    "metadata",
    "scarce_resources",
    "providers",
    "seats",
    "harness_seats",
    "personas",
    "lanes",
    "budget_fallbacks",
    "cade",
    "enforcement",
    "attribution"
  ],
  "properties": {
    "$comment": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "Provenance banner naming the Dhall source of truth and its regeneration command."
    },
    "schema_version": {
      "type": "integer",
      "const": 5
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner_linear_issue", "founding_docs"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "owner_linear_issue": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]+$"
        },
        "founding_docs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "scarce_resources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "notes"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": { "enum": ["human", "model"] },
          "notes": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "providers": {
      "description": "Provider allow-list (TIN-7760). Each entry names the exact model ids a seat on that provider may run, its access path and its endpoints. Model ids are keyed by endpoint. A seat whose provider, endpoint or model id is not admitted fails closed.",
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "model_ids", "access", "endpoints", "notes"],
        "properties": {
          "id": { "$ref": "#/$defs/providerId" },
          "model_ids": {
            "description": "The model ids on this provider's admitted endpoints. A forbidden endpoint's ids never appear here.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/modelId" }
          },
          "access": { "$ref": "#/$defs/nonEmptyString" },
          "endpoints": {
            "description": "Access paths to the provider, each with the model ids it uses. A refused endpoint is listed with admitted false so a consumer can recognise and refuse it.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "model_ids", "admitted", "status", "notes"],
              "properties": {
                "id": { "$ref": "#/$defs/endpointId" },
                "model_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/modelId" }
                },
                "admitted": { "type": "boolean" },
                "status": { "enum": ["in-service", "unmeasured", "forbidden"] },
                "notes": { "$ref": "#/$defs/nonEmptyString" }
              },
              "allOf": [
                {
                  "if": { "required": ["id"], "properties": { "id": { "const": "moonshot-platform" } } },
                  "then": { "properties": { "admitted": { "const": false }, "status": { "const": "forbidden" } } }
                },
                {
                  "if": { "required": ["id"], "properties": { "id": { "const": "kimi-coding" } } },
                  "then": { "properties": { "model_ids": { "items": { "enum": ["k3.1-pro"] } } } }
                },
                {
                  "if": { "required": ["status"], "properties": { "status": { "const": "forbidden" } } },
                  "then": { "properties": { "admitted": { "const": false } } }
                },
                {
                  "if": { "required": ["admitted"], "properties": { "admitted": { "const": false } } },
                  "then": { "properties": { "status": { "const": "forbidden" } } }
                }
              ]
            }
          },
          "notes": { "$ref": "#/$defs/nonEmptyString" }
        },
        "allOf": [
          {
            "if": { "required": ["id"], "properties": { "id": { "const": "anthropic" } } },
            "then": {
              "properties": {
                "model_ids": { "items": { "pattern": "^claude-(opus|sonnet|haiku)-5-5$" } },
                "endpoints": { "items": { "properties": { "id": { "const": "anthropic" } } } }
              }
            }
          },
          {
            "if": { "required": ["id"], "properties": { "id": { "const": "kimi" } } },
            "then": {
              "properties": {
                "model_ids": { "items": { "enum": ["k3.1-pro"] } },
                "endpoints": {
                  "items": { "properties": { "id": { "enum": ["kimi-coding", "moonshot-platform"] } } },
                  "allOf": [
                    { "contains": { "properties": { "id": { "const": "kimi-coding" }, "admitted": { "const": true } } } },
                    { "contains": { "properties": { "id": { "const": "moonshot-platform" }, "admitted": { "const": false } } } }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "seats": {
      "description": "First-class seat records. Seat names are load-bearing routing identities, not free-form model_classes strings.",
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "model_class",
          "model_id_source",
          "provider",
          "cost_tier",
          "default_personas",
          "forbidden_personas",
          "notes"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/seatId" },
          "model_class": { "$ref": "#/$defs/seatId" },
          "model_id": {
            "description": "Exact model the seat runs (J81). Omitted for a provider-managed seat such as fable.",
            "$ref": "#/$defs/modelId"
          },
          "model_id_source": {
            "description": "Where the seat's model id comes from. pinned: this policy names it. account-config: a config value read from the account after login and never written here (TIN-7125). Only fable is account-config.",
            "enum": ["pinned", "account-config"]
          },
          "provider": {
            "description": "The providers[] entry whose allow-list admits this seat's model_id.",
            "$ref": "#/$defs/providerId"
          },
          "endpoint": {
            "description": "The admitted provider endpoint whose model_ids hold this seat's model_id. Omitted for Anthropic seats, whose ids do not vary by endpoint.",
            "$ref": "#/$defs/endpointId"
          },
          "cost_tier": { "enum": ["scarce", "high", "medium", "low"] },
          "default_personas": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "forbidden_personas": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "notes": { "$ref": "#/$defs/nonEmptyString" }
        },
        "allOf": [
          {
            "if": { "required": ["model_class"], "properties": { "model_class": { "const": "fable" } } },
            "then": { "allOf": [ { "not": { "required": ["model_id"] } }, { "not": { "required": ["endpoint"] } } ], "properties": { "provider": { "const": "anthropic" }, "model_id_source": { "const": "account-config" } } }
          },
          {
            "if": { "required": ["model_class"], "properties": { "model_class": { "const": "kimi" } } },
            "then": {
              "required": ["model_id", "endpoint"],
              "properties": {
                "model_id": { "const": "k3.1-pro" },
                "model_id_source": { "const": "pinned" },
                "provider": { "const": "kimi" },
                "endpoint": { "const": "kimi-coding" },
                "default_personas": {
                  "not": { "contains": { "enum": ["fable", "critical", "adversarial"] } }
                },
                "forbidden_personas": {
                  "allOf": [
                    { "contains": { "const": "fable" } },
                    { "contains": { "const": "critical" } },
                    { "contains": { "const": "adversarial" } }
                  ]
                }
              }
            }
          },
          {
            "if": { "required": ["model_class"], "properties": { "model_class": { "const": "opus" } } },
            "then": { "required": ["model_id"], "not": { "required": ["endpoint"] }, "properties": { "model_id": { "pattern": "^claude-opus-" }, "model_id_source": { "const": "pinned" }, "provider": { "const": "anthropic" } } }
          },
          {
            "if": { "required": ["model_class"], "properties": { "model_class": { "const": "sonnet" } } },
            "then": { "required": ["model_id"], "not": { "required": ["endpoint"] }, "properties": { "model_id": { "pattern": "^claude-sonnet-" }, "model_id_source": { "const": "pinned" }, "provider": { "const": "anthropic" } } }
          },
          {
            "if": { "required": ["model_class"], "properties": { "model_class": { "const": "haiku" } } },
            "then": { "required": ["model_id"], "not": { "required": ["endpoint"] }, "properties": { "model_id": { "pattern": "^claude-haiku-" }, "model_id_source": { "const": "pinned" }, "provider": { "const": "anthropic" } } }
          }
        ]
      }
    },
    "harness_seats": {
      "description": "Agent-harness dispatch identities Fable or Cade may delegate bounded work to. A harness seat is not a model class and never appears in a persona's model_classes: it names the harness, the model lane it rides, the exact task envelope it may receive, the surface dispatch must go through, the fixed launcher behind a transport surface, and its posture.",
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "harness",
          "model_lane",
          "purpose",
          "delegable_tasks",
          "forbidden_tasks",
          "dispatch_surface",
          "posture"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/harnessSeatId" },
          "harness": { "$ref": "#/$defs/harnessId" },
          "model_lane": { "$ref": "#/$defs/nonEmptyString" },
          "purpose": { "$ref": "#/$defs/nonEmptyString" },
          "delegable_tasks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "forbidden_tasks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          },
          "dispatch_surface": { "$ref": "#/$defs/nonEmptyString" },
          "launcher": {
            "description": "The fixed launcher behind a transport surface such as an swb recipient. Omitted when the surface is itself the launcher.",
            "$ref": "#/$defs/nonEmptyString"
          },
          "posture": {
            "description": "evidentiary-only: the output is evidence for the synthesis seat or the Opus merge gate. gated-worker: the Cade job seat's output is work product whose external acts wait for a GO. No harness seat carries the operator WORD leg or gates a merge.",
            "enum": ["evidentiary-only", "gated-worker"]
          }
        },
        "allOf": [
          {
            "if": { "required": ["harness"], "properties": { "harness": { "const": "pi" } } },
            "then": { "not": { "required": ["launcher"] }, "properties": { "posture": { "const": "evidentiary-only" } } }
          },
          {
            "if": { "required": ["id"], "properties": { "id": { "const": "claude-code@cade" } } },
            "then": {
              "required": ["launcher"],
              "properties": {
                "harness": { "const": "claude-code" },
                "dispatch_surface": { "const": "swb:claude:sting:cade-jobs" },
                "posture": { "const": "gated-worker" },
                "forbidden_tasks": {
                  "allOf": [
                    { "contains": { "const": "word-leg-ratification" } },
                    { "contains": { "const": "adversarial-refutation-of-record" } },
                    { "contains": { "const": "merge-gating-review" } },
                    { "contains": { "const": "review-own-pr" } },
                    { "contains": { "const": "credential-minting" } }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "model_classes",
          "purpose",
          "doctrine",
          "forbidden_tasks"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "model_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/modelClass" }
          },
          "purpose": { "$ref": "#/$defs/nonEmptyString" },
          "doctrine": { "$ref": "#/$defs/nonEmptyString" },
          "forbidden_tasks": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route", "persona", "purpose"],
        "properties": {
          "route": { "$ref": "#/$defs/route" },
          "persona": {
            "description": "A persona id, or a harness seat id for a mythos.delegate.* lane.",
            "$ref": "#/$defs/identifier"
          },
          "purpose": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "budget_fallbacks": {
      "description": "Seat downgrades allowed when a seat's quota is exhausted (J81(e)). Each names the personas and the exact lanes it reaches plus the obligations the downgraded lane carries. A fallback never reaches fable or haiku, the adversarial persona, the merge gate or a host act. It always carries the merge, host-act and receipt obligations.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from_seat",
          "to_seat",
          "trigger",
          "personas",
          "lanes",
          "obligations"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "from_seat": { "$ref": "#/$defs/seatId" },
          "to_seat": {
            "$ref": "#/$defs/seatId",
            "not": { "enum": ["fable", "haiku", "kimi"] }
          },
          "trigger": { "$ref": "#/$defs/nonEmptyString" },
          "personas": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" },
            "not": { "contains": { "const": "adversarial" } }
          },
          "lanes": {
            "description": "Every route the fallback reaches. A lane of a covered persona that is not listed keeps its default seat.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/route" },
            "not": {
              "contains": {
                "enum": ["mythos.gate.review", "mythos.act.host", "mythos.adversarial"]
              }
            }
          },
          "obligations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" },
            "allOf": [
              { "contains": { "const": "merge-waits-for-opus-review" } },
              { "contains": { "const": "no-host-or-credential-act" } },
              { "contains": { "const": "downgrade-recorded-in-receipt" } }
            ]
          }
        }
      }
    },
    "cade": {
      "description": "Cade orchestration (TIN-7760, TIN-7125): the orchestrator, the advisory cross-provider review, the auto-level child rule, custody classes, the cade.* lanes, the broker and dispatch.",
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "cross_provider_review", "children", "custody_classes", "lanes", "broker", "dispatch"],
      "properties": {
        "orchestrator": { "$ref": "#/$defs/nonEmptyString" },
        "cross_provider_review": { "$ref": "#/$defs/nonEmptyString" },
        "children": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "custody", "seat_resolution", "on_no_seat", "provider_fallback", "bindings", "notes"],
          "properties": {
            "level": { "const": "auto" },
            "custody": { "const": "follows-parent-home" },
            "seat_resolution": {
              "description": "A child's effective seats are its lane's default and alternate seats, in that order, that also sit in its parent home's custody class.",
              "const": "lane-seats-within-parent-custody"
            },
            "on_no_seat": {
              "description": "When no effective seat remains the child waits. It never borrows a seat from outside its parent home's custody.",
              "const": "wait"
            },
            "provider_fallback": { "const": "none" },
            "bindings": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" },
              "allOf": [
                { "contains": { "const": "batch-confirm-for-external-acts" } },
                { "contains": { "const": "health-never-hosted" } },
                { "contains": { "const": "client-exports-never-kimi" } },
                { "contains": { "const": "ownership-and-live-session-checks" } },
                { "contains": { "const": "hooks-advisory" } }
              ]
            },
            "notes": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "custody_classes": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "seats", "harness_seats", "notes"],
            "properties": {
              "id": { "$ref": "#/$defs/custodyId" },
              "seats": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["opus", "kimi"] }
              },
              "harness_seats": {
                "description": "Harness seats that may see this class's data. Child seat resolution reads seats only. SPR-182 puts every Kimi seat, pi-k3 included, in the ops class.",
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/harnessSeatId" }
              },
              "notes": { "$ref": "#/$defs/nonEmptyString" }
            },
            "allOf": [
              {
                "if": { "required": ["id"], "properties": { "id": { "const": "confidential" } } },
                "then": {
                  "properties": {
                    "seats": { "items": { "const": "opus" } },
                    "harness_seats": { "type": "array", "not": { "contains": {} } }
                  }
                }
              },
              {
                "if": { "required": ["id"], "properties": { "id": { "const": "health" } } },
                "then": {
                  "properties": {
                    "seats": { "type": "array", "not": { "contains": {} } },
                    "harness_seats": { "type": "array", "not": { "contains": {} } }
                  }
                }
              },
              {
                "if": { "required": ["id"], "properties": { "id": { "const": "ops" } } },
                "then": {
                  "properties": {
                    "seats": { "contains": { "const": "kimi" } },
                    "harness_seats": { "allOf": [ { "contains": { "const": "pi-k3" } }, { "contains": { "const": "claude-code@cade" } } ] }
                  }
                }
              }
            ]
          }
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["route", "persona", "custody", "default_seat", "alternate_seats", "gate", "purpose"],
            "properties": {
              "route": { "$ref": "#/$defs/cadeRoute" },
              "persona": { "$ref": "#/$defs/identifier" },
              "custody": {
                "$ref": "#/$defs/custodyId",
                "not": { "const": "health" }
              },
              "default_seat": { "enum": ["opus", "kimi"] },
              "alternate_seats": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["opus", "kimi"] }
              },
              "gate": { "$ref": "#/$defs/nonEmptyString" },
              "purpose": { "$ref": "#/$defs/nonEmptyString" }
            },
            "allOf": [
              {
                "if": { "required": ["custody"], "properties": { "custody": { "const": "confidential" } } },
                "then": {
                  "properties": {
                    "default_seat": { "const": "opus" },
                    "alternate_seats": { "not": { "contains": { "const": "kimi" } } }
                  }
                }
              },
              {
                "if": { "required": ["persona"], "properties": { "persona": { "enum": ["critical", "adversarial"] } } },
                "then": {
                  "properties": {
                    "default_seat": { "const": "opus" },
                    "alternate_seats": { "not": { "contains": { "const": "kimi" } } }
                  }
                }
              }
            ]
          }
        },
        "broker": {
          "description": "The Cade broker (TIN-7125, new policy). Kimi may route a request to a cade.* lane and author cade.dispatch/v1 envelopes. It gates nothing, never names a model and never sets custody.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seat",
            "may",
            "gates",
            "names_model",
            "writes",
            "unattended",
            "new_policy",
            "notes"
          ],
          "properties": {
            "seat": {
              "const": "kimi"
            },
            "may": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "route",
                  "author-envelope"
                ]
              }
            },
            "gates": {
              "description": "What the broker may gate: nothing.",
              "type": "array",
              "not": {
                "contains": {}
              }
            },
            "names_model": {
              "type": "boolean",
              "const": false
            },
            "writes": {
              "description": "Envelope fields the broker writes. Cade's own code stamps the rest, custody from the source item's label included.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "lane",
                  "tags",
                  "goal",
                  "inputs",
                  "allowed_effects",
                  "budget_envelope"
                ]
              }
            },
            "unattended": {
              "const": "admitted"
            },
            "new_policy": {
              "type": "boolean",
              "const": true
            },
            "notes": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "dispatch": {
          "description": "Cade dispatch (TIN-7125): the shared envelope and receipt contract, transport, root resolution, carve-out reroute and inheritance, custody narrowing, units, the Fable id, the job seat, effects, credentials and accounting. Nothing here caps count, depth or cost.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "envelope_schema",
            "envelope_schema_file",
            "envelope_fields",
            "receipt_schema",
            "receipt_schema_file",
            "receipt_fields",
            "recipient",
            "reply_kinds",
            "receipt_statuses",
            "harness_seat",
            "resolver",
            "carve_out_tags",
            "carve_out_match",
            "carve_out_seat",
            "develop_uncertain_tags",
            "tag_inheritance",
            "custody_source",
            "custody_order",
            "custody_rule",
            "child_dispatch",
            "fable_model_id",
            "job_seat",
            "lanes",
            "units",
            "unknown_unit",
            "effects",
            "credentials",
            "accounting",
            "notes"
          ],
          "properties": {
            "envelope_schema": {
              "const": "cade.dispatch/v1"
            },
            "envelope_schema_file": {
              "const": "policy/cade-dispatch.schema.json"
            },
            "envelope_fields": {
              "type": "array",
              "minItems": 13,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "job_id",
                  "parent_job_id",
                  "depth",
                  "root_id",
                  "lane",
                  "tags",
                  "custody",
                  "goal",
                  "inputs",
                  "allowed_effects",
                  "budget_envelope",
                  "requested_by",
                  "created_at"
                ]
              }
            },
            "receipt_schema": {
              "const": "cade.dispatch.receipt/v1"
            },
            "receipt_schema_file": {
              "const": "policy/cade-dispatch-receipt.schema.json"
            },
            "receipt_fields": {
              "type": "array",
              "minItems": 16,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "job_id",
                  "parent_job_id",
                  "depth",
                  "lane",
                  "resolved_root_model",
                  "observed_models",
                  "children",
                  "peak_concurrency",
                  "observed_depth",
                  "tokens",
                  "wall_seconds",
                  "effects",
                  "go_refs",
                  "result",
                  "status",
                  "policy_rev"
                ]
              }
            },
            "recipient": {
              "const": "claude:sting:cade-jobs"
            },
            "reply_kinds": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "reply",
                  "needs-go",
                  "dispatch-request"
                ]
              }
            },
            "receipt_statuses": {
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "done",
                  "failed",
                  "needs-go",
                  "dispatch-request"
                ]
              }
            },
            "harness_seat": {
              "const": "claude-code@cade"
            },
            "resolver": {
              "const": "fixed-resolver-reads-this-policy"
            },
            "carve_out_tags": {
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "adversarial",
                  "red-team",
                  "purple-team",
                  "deep-iteration"
                ]
              }
            },
            "carve_out_match": {
              "const": "normalized-prefix"
            },
            "carve_out_seat": {
              "const": "opus"
            },
            "develop_uncertain_tags": {
              "const": "opus"
            },
            "tag_inheritance": {
              "const": "carve-out-tags-pass-to-every-child"
            },
            "custody_source": {
              "const": "source-item-label"
            },
            "custody_order": {
              "description": "Custody classes from widest to narrowest. A child's custody may stay or move right, never left.",
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/custodyId"
              }
            },
            "custody_rule": {
              "const": "narrow-only"
            },
            "child_dispatch": {
              "const": "dispatch-request-through-cade"
            },
            "fable_model_id": {
              "description": "The Fable id is a config value read from the account after login. The policy never carries a value.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "config_key",
                "source",
                "account",
                "admitted_when",
                "id_pattern",
                "on_unread",
                "notes"
              ],
              "properties": {
                "config_key": {
                  "const": "fable_model_id"
                },
                "source": {
                  "const": "account"
                },
                "account": {
                  "const": "cade@xoxd.ai"
                },
                "admitted_when": {
                  "const": "read-from-account-after-login"
                },
                "id_pattern": {
                  "type": "string",
                  "pattern": "^\\^claude-fable-"
                },
                "on_unread": {
                  "const": "wait"
                },
                "notes": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              }
            },
            "job_seat": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "host",
                "unix_user",
                "account",
                "config_dir",
                "operator_login",
                "key_reach",
                "notes"
              ],
              "properties": {
                "host": {
                  "const": "sting"
                },
                "unix_user": {
                  "const": "jess"
                },
                "account": {
                  "const": "cade@xoxd.ai"
                },
                "config_dir": {
                  "description": "A Claude Code config dir of its own. Jess's own ~/.claude is never a job's.",
                  "type": "string",
                  "pattern": "^\\$HOME/\\.claude-[a-z0-9-]+$"
                },
                "operator_login": {
                  "const": "never"
                },
                "key_reach": {
                  "const": "accepted"
                },
                "notes": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              }
            },
            "lanes": {
              "type": "array",
              "minItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "route",
                  "parent_persona",
                  "root_seat",
                  "custody",
                  "gate",
                  "purpose"
                ],
                "properties": {
                  "route": {
                    "$ref": "#/$defs/dispatchRoute"
                  },
                  "parent_persona": {
                    "enum": [
                      "fable-orchestrator",
                      "critical"
                    ]
                  },
                  "root_seat": {
                    "enum": [
                      "fable",
                      "opus"
                    ]
                  },
                  "custody": {
                    "description": "Custody classes the lane admits from the source item's label. Each one must list the claude-code@cade harness seat, so confidential and health are out.",
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "public",
                        "ops"
                      ]
                    }
                  },
                  "gate": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "purpose": {
                    "$ref": "#/$defs/nonEmptyString"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "parent_persona"
                      ],
                      "properties": {
                        "parent_persona": {
                          "const": "fable-orchestrator"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "root_seat": {
                          "const": "fable"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "parent_persona"
                      ],
                      "properties": {
                        "parent_persona": {
                          "const": "critical"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "root_seat": {
                          "const": "opus"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "route"
                      ],
                      "properties": {
                        "route": {
                          "const": "cade.delegate.develop"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "parent_persona": {
                          "const": "critical"
                        },
                        "root_seat": {
                          "const": "opus"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "root_seat"
                      ],
                      "properties": {
                        "root_seat": {
                          "const": "fable"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "parent_persona": {
                          "const": "fable-orchestrator"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "units": {
              "type": "array",
              "minItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "seats",
                  "notes"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "research",
                      "bulk",
                      "code",
                      "gate",
                      "carve-out"
                    ]
                  },
                  "seats": {
                    "description": "Worker seats in preference order. Fable never runs a unit and Kimi never runs inside a Claude Code job.",
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "opus",
                        "sonnet",
                        "haiku"
                      ]
                    }
                  },
                  "notes": {
                    "$ref": "#/$defs/nonEmptyString"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "code",
                            "gate",
                            "carve-out"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "seats": {
                          "items": {
                            "const": "opus"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            },
            "unknown_unit": {
              "const": "opus"
            },
            "effects": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "envelope",
                  "needs_go",
                  "identity",
                  "notes"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "none",
                      "result-doc",
                      "linear-comment",
                      "github-pr",
                      "spend",
                      "external-send",
                      "host-act",
                      "merge",
                      "credential-change"
                    ]
                  },
                  "envelope": {
                    "type": "boolean"
                  },
                  "needs_go": {
                    "type": "boolean"
                  },
                  "identity": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "notes": {
                    "$ref": "#/$defs/nonEmptyString"
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "needs_go"
                      ],
                      "properties": {
                        "needs_go": {
                          "const": true
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "envelope": {
                          "const": false
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "enum": [
                            "spend",
                            "external-send",
                            "host-act",
                            "merge",
                            "credential-change"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "needs_go": {
                          "const": true
                        },
                        "envelope": {
                          "const": false
                        }
                      }
                    }
                  }
                ]
              }
            },
            "credentials": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "provider",
                  "holder",
                  "minted_by",
                  "agent_mints",
                  "notes"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "cade-claude",
                      "cade-linear",
                      "cade-github"
                    ]
                  },
                  "provider": {
                    "enum": [
                      "anthropic",
                      "linear",
                      "github"
                    ]
                  },
                  "holder": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "minted_by": {
                    "enum": [
                      "jess-attended-login",
                      "jess-in-provider-ui"
                    ]
                  },
                  "agent_mints": {
                    "type": "boolean",
                    "const": false
                  },
                  "notes": {
                    "$ref": "#/$defs/nonEmptyString"
                  }
                }
              }
            },
            "accounting": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "budget_envelope",
                "containment",
                "queue",
                "audit",
                "notes"
              ],
              "properties": {
                "budget_envelope": {
                  "const": "report-only"
                },
                "containment": {
                  "const": "none"
                },
                "queue": {
                  "const": "fifo"
                },
                "audit": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/identifier"
                  }
                },
                "notes": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              }
            },
            "notes": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      }
    },
    "enforcement": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "rule"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "severity": { "enum": ["error", "warn"] },
          "rule": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["convention", "values"],
      "properties": {
        "convention": { "$ref": "#/$defs/nonEmptyString" },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "route": {
      "type": "string",
      "pattern": "^mythos(\\.[a-z0-9-]+)+$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "cadeRoute": {
      "type": "string",
      "pattern": "^cade(\\.[a-z0-9-]+)+$"
    },
    "seatId": {
      "description": "First-class seat names. Adding a seat is a policy change, not a string edit.",
      "enum": ["fable", "opus", "sonnet", "haiku", "kimi"]
    },
    "providerId": {
      "description": "Allow-listed providers. Adding one is a policy change, not a string edit.",
      "enum": ["anthropic", "kimi"]
    },
    "custodyId": {
      "description": "Cade custody classes. A child's custody class follows its parent home.",
      "enum": ["confidential", "health", "ops", "public"]
    },
    "modelId": {
      "description": "An exact model ID: a Claude ID such as claude-opus-5-5, the Kimi Code id k3.1-pro, or the forbidden Platform id kimi-k3.1-pro, which only a refused endpoint may list.",
      "type": "string",
      "pattern": "^(claude-(opus|sonnet|haiku)-[0-9]+-[0-9]+|k3\\.1-pro|kimi-k3\\.1-pro)$"
    },
    "endpointId": {
      "description": "Provider endpoints. Adding one is a policy change, not a string edit.",
      "enum": ["anthropic", "kimi-coding", "moonshot-platform"]
    },
    "harnessSeatId": {
      "description": "First-class harness-seat names. Adding one is a policy change, not a string edit.",
      "enum": ["pi", "pi-k3", "claude-code@cade"]
    },
    "harnessId": {
      "description": "The agent harness a seat dispatches through. Kimi has no dispatch envelope of its own, so the Kimi reviewer rides the pi harness as pi-k3. Cade's job seat runs Claude Code.",
      "enum": ["pi", "claude-code"]
    },
    "dispatchRoute": {
      "description": "Cade dispatch lanes (TIN-7125). Adding one is a policy change, not a string edit.",
      "enum": ["cade.delegate.research", "cade.delegate.draft", "cade.delegate.business", "cade.delegate.marketing", "cade.delegate.develop"]
    },
    "modelClass": {
      "description": "A seat name, or the operator taking the lane personally.",
      "enum": ["fable", "opus", "sonnet", "haiku", "kimi", "operator"]
    }
  }
}
